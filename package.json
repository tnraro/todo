{
  "name": "anon-kanban-todo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:server & bun run dev:web & wait",
    "dev:server": "bun --watch --cwd packages/server src/index.ts",
    "dev:web": "bun --cwd packages/web vite",
    "build": "bun --cwd packages/web vite build",
    "start": "bun --cwd packages/server src/index.ts",
    "test": "bun test packages/server && bun run --cwd packages/web test:web",
    "test:server": "bun test packages/server",
    "typecheck": "bun --cwd packages/web tsc --noEmit"
  }
}
